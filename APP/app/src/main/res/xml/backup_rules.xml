<?xml version="1.0" encoding="utf-8"?>
<!-- https://developer.android.com/guide/topics/data/autobackup -->
<full-backup-content>
    <!-- 현재 위치에서 시작하는 이동 경로는 민감하며 잠깐만 필요한 캐시다. -->
    <exclude domain="sharedpref" path="jit_live_route.xml"/>
    <!-- 연동한 캘린더 id 는 이 기기에서만 뜻이 있다. -->
    <exclude domain="sharedpref" path="jit_calendar_link.xml"/>
    <!-- 도착 기록과 이동 중 단계는 이 기기의 추적이 잠깐 쓰는 사본이다. 서버에 관측이 있다. -->
    <exclude domain="sharedpref" path="jit_arrivals.xml"/>
    <exclude domain="sharedpref" path="jit_trip_progress.xml"/>
</full-backup-content>
