# 이 파일을 .env 로 복사해서 값을 채운다.
# .env 는 절대 커밋하지 않는다. 이 파일에는 값을 넣지 않는다.
#
# ===========================================================================
# 이 파일은 "로컬 개발용" 이다
# ===========================================================================
# 팀 공용 서버(Render)는 이 파일을 읽지 않는다. 그쪽 값은 Render 대시보드의
# Environment 에 들어 있다. 여기를 고쳐도 배포 서버는 바뀌지 않는다.
#
# 앱만 만지는 팀원은 이 파일이 필요 없다 — 앱은 공용 서버에 붙는다
# (APP/gradle.properties 의 jitApiBaseUrl). 백엔드를 고칠 때만 채운다.
#
# prod.py 가 읽는 배포 전용 값은 이 파일에서 효력이 없다. 목록은 맨 아래 참고.
#
# 값에 # 이나 $ 를 쓰지 않는다. dotenv 파서가 주석으로 잘라먹는다.
# 부득이하면 큰따옴표로 감싼다.
#
# 시크릿 키 생성:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=

# 참고용. 이 줄은 실제로 효력이 없다 — dotenv 는 base.py 안에서 로드되므로
# Django 가 설정 모듈을 결정한 뒤에 읽힌다. manage.py 가 config.settings.dev 를
# 기본값으로 넣는다. prod 로 바꿀 때는 셸 환경변수로 직접 export 한다.
DJANGO_SETTINGS_MODULE=config.settings.dev

# **반드시 채운다.** 비우면 dev 설정이 시작을 거부한다.
#
# 팀은 DB 를 **Neon 하나**로 쓴다. 로컬 SQLite 를 따로 두지 않는다 — 두면 로컬
# 데이터와 팀 데이터가 갈라지고, "지금 어느 DB 를 보고 있나" 가 매번 질문이 된다.
#
# 주소는 저장소에 두지 않는다. 관리자에게 받는다 (docs/team-setup.md 1절).
#
#   postgresql://<user>:<pass>@<endpoint>.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# Neon 에 붙은 상태에서 주의할 것 — **되돌릴 사본이 없다.**
#   - 삭제·초기화 실험이 팀 전체에 그대로 반영된다.
#   - `manage.py flush`, `purge_test_accounts.py --yes` 는 팀 데이터를 지운다.
#   - 계정을 지우면 cascade 로 일정·알람계획·관측이 같이 사라진다.
#
# 검증 스크립트는 Neon 에 붙이지 않는다. 한 번 돌 때 계정 100개 가까이 만든다.
# `scripts/run_local_suite.py` 가 임시 폴더의 **일회용** SQLite 를 알아서 쓴다.
# 그건 관리하는 DB 가 아니라 검증이 도는 동안만 있는 파일이다.
#
# 일회용 DB 로 잠깐 돌려 볼 때는 파일을 고치지 말고 셸에서 넘긴다.
#   $env:DATABASE_URL="sqlite:///$env:TEMP/jit_scratch.sqlite3"; python manage.py migrate
#
# **direct(`-pooler` 없는) 주소를 쓴다.** Neon 은 두 엔드포인트를 주는데,
# pooler 는 PgBouncer 트랜잭션 모드라 PREPARE 같은 세션 기능이 없고
# 마이그레이션이 깨질 수 있다. pooler 는 연결 고갈을 푸는 도구이고 우리는
# 그 문제가 없다(gunicorn 워커 2개 + conn_max_age=600 -> 동시 연결 2개 수준).
DATABASE_URL=

# ===========================================================================
# 지금 필요 — P1 을 막고 있다
# ===========================================================================

# 카카오맵 (대중교통·도보 경로 F4.1 + 로컬 장소 검색 F3.4)
#   https://developers.kakao.com/console/app
#   앱 생성 → 앱 키 → REST API 키
#   같은 앱 → 제품 설정 > 카카오맵 → 사용 설정 ON   (심사 없음)
#   쿼터: 대중교통 일 1,000건 / 도보 일 1,000건 (각각 별도 집계)
#   앱은 하나만. 무료 쿼터는 계정당 첫 활성화 앱 1개뿐이다.
#
#   키 생성 화면의 "호출 허용 IP 주소"는 비워둔다. 채우면 그 IP 외 호출이 전부
#   막힌다. 개발 중에는 팀원마다·장소마다 IP 가 바뀌므로 원인 찾기 어려운 실패가
#   된다. 서버 배포 후 고정 IP 가 생기면 그때 추가한다.
#   "카카오 로그인 / 비즈니스 인증 리다이렉트 URI"도 비워둔다 (SimpleJWT 사용).
KAKAO_REST_API_KEY=

# ===========================================================================
# 지금 받아두면 좋음 — 무료, 활성화 지연 가능
# ===========================================================================

# 기상청 단기예보 (F10, P3)
#   https://www.data.go.kr → "기상청_단기예보 조회서비스" → 활용신청
#   마이페이지 > 개발계정 에서 일반 인증키(Decoding) 사용
KMA_API_KEY=

# ===========================================================================
# P3 — 자연어 일정 파싱 (F12)
# ===========================================================================

# OpenAI
#   https://platform.openai.com/api-keys
#   무료 티어 없음. 선불 결제 최소 $5 (기본 $10).
#   실습(Lab) 키를 재사용하지 않는다. 프로젝트 전용 키를 따로 만든다.
OPENAI_API_KEY=

# Structured Outputs(strict) 지원 모델이어야 한다.
# 모델 ID 는 자주 바뀌므로 배포 전 지원 여부를 확인한다.
OPENAI_MODEL=

# ===========================================================================
# P4 — 푸시
# ===========================================================================

# FCM 서비스 계정 JSON 경로 (파일은 저장소 밖에 둔다)
#   https://console.firebase.google.com
#   프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
#
#   APP/app/google-services.json 과 다른 파일이다. 그건 클라이언트용이고
#   APK 에 박혀 배포되므로 비밀이 아니다. 이 서비스 계정 JSON 은 서버 전권을
#   가지므로 절대 커밋하지 않는다. 경로만 여기에 적는다.
FCM_CREDENTIALS_PATH=

# ===========================================================================
# 나중 / 조건부
# ===========================================================================

# 카카오모빌리티 자동차 길찾기 (F4.2 택시 대안, 제휴 승인 필요)
#   https://developers.kakaomobility.com
#   없으면 택시 옵션만 빠진다. P1·P2 무영향.
KAKAO_MOBILITY_KEY=

# P2 이후. 비우면 Celery 없이 관리 커맨드로 대체한다.
REDIS_URL=

# --- 로그인 방식 미결 (back-spec 5.1 은 SimpleJWT, UI 에는 소셜 버튼) -------
# 소셜 로그인으로 확정되면 주석을 풀고 채운다. SimpleJWT 로 가면 불필요하다.
# KAKAO_NATIVE_APP_KEY=
# GOOGLE_OAUTH_CLIENT_ID=

# ===========================================================================
# 배포(prod) 전용 — 이 파일에서는 쓰이지 않는다
# ===========================================================================
# config/settings/prod.py 가 읽는 값들이다. 로컬은 dev 설정으로 도니까
# 여기에 넣어도 효력이 없다. 배포처(Render 등)의 환경변수에 넣는다.
#
#   DJANGO_ALLOWED_HOSTS          배포 도메인. 비면 서버가 시작하지 않는다
#   DJANGO_SECURE_SSL_REDIRECT    TLS 없이 임시 확인할 때만 0
#   DJANGO_CORS_ORIGINS           웹 대시보드를 붙일 때
#   WEB_CONCURRENCY               gunicorn 워커 수 (기본 2)
#   DJANGO_LOG_LEVEL              기본 INFO
#   DJANGO_HSTS_SECONDS           도메인 확정 후에만 켠다
#
# 로컬에서 prod 설정을 흉내내 볼 때는 셸에서 넘긴다.
#   $env:DJANGO_SETTINGS_MODULE="config.settings.prod"
#   $env:DJANGO_ALLOWED_HOSTS="localhost"; $env:DJANGO_SECURE_SSL_REDIRECT="0"
