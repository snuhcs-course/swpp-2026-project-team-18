# 이 파일을 .env 로 복사해서 값을 채운다.
# .env 는 절대 커밋하지 않는다. 이 파일에는 값을 넣지 않는다.
#
# 값에 # 이나 $ 를 쓰지 않는다. dotenv 파서가 주석으로 잘라먹는다.
# 부득이하면 큰따옴표로 감싼다.
#
# 시크릿 키 생성:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=

# 참고용. 이 줄은 실제로 효력이 없다 — dotenv 는 base.py 안에서 로드되므로
# Django 가 설정 모듈을 결정한 뒤에 읽힌다. manage.py 가 config.settings.dev 를
# 기본값으로 넣는다. prod 로 바꿀 때는 셸 환경변수로 직접 export 한다.
DJANGO_SETTINGS_MODULE=config.settings.dev

# 비우면 SQLite(db.sqlite3) — 혼자 실험할 때만 쓴다.
#
# **팀 공용 DB 에 붙으려면 여기에 Postgres 주소를 넣는다.** 그래야 다른
# 작업자와 같은 데이터를 본다. 주소는 공용 서버 관리자에게 받는다(저장소에
# 두지 않는다). docs/team-setup.md 참고.
#
#   postgres://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/justintime?sslmode=require
#
# 주의: 공용 DB 에 붙은 상태로 테스트 데이터를 만들면 팀 전체가 본다.
# 파괴적인 실험은 DATABASE_URL 을 비워 로컬 SQLite 에서 할 것.
DATABASE_URL=

# ===========================================================================
# 지금 필요 — P1 을 막고 있다
# ===========================================================================

# 카카오맵 (대중교통·도보 경로 F4.1 + 로컬 장소 검색 F3.4)
#   https://developers.kakao.com/console/app
#   앱 생성 → 앱 키 → REST API 키
#   같은 앱 → 제품 설정 > 카카오맵 → 사용 설정 ON   (심사 없음)
#   쿼터: 대중교통 일 1,000건 / 도보 일 1,000건 (각각 별도 집계)
#   앱은 하나만. 무료 쿼터는 계정당 첫 활성화 앱 1개뿐이다.
#
#   키 생성 화면의 "호출 허용 IP 주소"는 비워둔다. 채우면 그 IP 외 호출이 전부
#   막힌다. 개발 중에는 팀원마다·장소마다 IP 가 바뀌므로 원인 찾기 어려운 실패가
#   된다. 서버 배포 후 고정 IP 가 생기면 그때 추가한다.
#   "카카오 로그인 / 비즈니스 인증 리다이렉트 URI"도 비워둔다 (SimpleJWT 사용).
KAKAO_REST_API_KEY=

# ===========================================================================
# 지금 받아두면 좋음 — 무료, 활성화 지연 가능
# ===========================================================================

# 기상청 단기예보 (F10, P3)
#   https://www.data.go.kr → "기상청_단기예보 조회서비스" → 활용신청
#   마이페이지 > 개발계정 에서 일반 인증키(Decoding) 사용
KMA_API_KEY=

# ===========================================================================
# P3 — 자연어 일정 파싱 (F12)
# ===========================================================================

# OpenAI
#   https://platform.openai.com/api-keys
#   무료 티어 없음. 선불 결제 최소 $5 (기본 $10).
#   실습(Lab) 키를 재사용하지 않는다. 프로젝트 전용 키를 따로 만든다.
OPENAI_API_KEY=

# Structured Outputs(strict) 지원 모델이어야 한다.
# 모델 ID 는 자주 바뀌므로 배포 전 지원 여부를 확인한다.
OPENAI_MODEL=

# ===========================================================================
# P4 — 푸시
# ===========================================================================

# FCM 서비스 계정 JSON 경로 (파일은 저장소 밖에 둔다)
#   https://console.firebase.google.com
#   프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
#
#   APP/app/google-services.json 과 다른 파일이다. 그건 클라이언트용이고
#   APK 에 박혀 배포되므로 비밀이 아니다. 이 서비스 계정 JSON 은 서버 전권을
#   가지므로 절대 커밋하지 않는다. 경로만 여기에 적는다.
FCM_CREDENTIALS_PATH=

# ===========================================================================
# 나중 / 조건부
# ===========================================================================

# 카카오모빌리티 자동차 길찾기 (F4.2 택시 대안, 제휴 승인 필요)
#   https://developers.kakaomobility.com
#   없으면 택시 옵션만 빠진다. P1·P2 무영향.
KAKAO_MOBILITY_KEY=

# P2 이후. 비우면 Celery 없이 관리 커맨드로 대체한다.
REDIS_URL=

# --- 로그인 방식 미결 (back-spec 5.1 은 SimpleJWT, UI 에는 소셜 버튼) -------
# 소셜 로그인으로 확정되면 주석을 풀고 채운다. SimpleJWT 로 가면 불필요하다.
# KAKAO_NATIVE_APP_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
