# 저장소 루트. 하위 APP/ 와 backend/ 에 각자의 .gitignore 가 따로 있다.

# ---------------------------------------------------------------------------
# 비밀. 실수로 떨어뜨려도 커밋되지 않게 넓게 막는다.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Firebase 서비스 계정 키. 서버 전권을 가진다.
# 절대 저장소 안에 두지 않는다. C:/Users/<user>/.secrets/justintime/ 같은
# 저장소 밖 경로에 두고 .env 의 FCM_CREDENTIALS_PATH 로 가리킨다.
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json

# 그 외 흔한 키 파일 형태
*.pem
*.p12
*.jks
*.keystore

# 예외: 이건 클라이언트용이고 APK 에 박혀 배포되므로 비밀이 아니다. 커밋한다.
!APP/app/google-services.json

# ---------------------------------------------------------------------------
# OS / 편집기
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# 설계 문서
# ---------------------------------------------------------------------------
# Spec/ 은 저장소에 올리지 않는다. 명세·체크리스트는 Wiki 로 관리한다.
# 로컬에는 그대로 두고 git 만 무시한다.
/Spec/

# ---------------------------------------------------------------------------
# 빌드 산출물 / 가상환경
# ---------------------------------------------------------------------------
# APP/ 과 backend/ 의 .gitignore 가 각자 막지만, 루트에서도 한 번 더 막는다.
.venv/
__pycache__/
*.pyc
*.sqlite3
build/
.gradle/
local.properties
